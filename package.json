{
  "name": "reconix",
  "productName": "Reconix",
  "version": "0.0.1",
  "description": "AI-driven penetration testing browser",
  "main": "./out/main/index.cjs",
  "author": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "predev": "npm run preflight",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prestart": "npm run preflight",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:smoke": "node scripts/smoke.mjs",
    "test:smoke:packaged": "node scripts/smoke.mjs --packaged"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-virtual": "^3.14.21",
    "electron-updater": "^6.8.9",
    "node-sqlite3-wasm": "^0.8.61",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "^8.19.0",
    "astring": "^1.9.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "highlight.js": "^11.11.1",
    "js-beautify": "^1.15.4",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}

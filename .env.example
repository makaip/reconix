# Copy to .env and fill in. Never commit the real .env.
# Consumed by docker-compose.yml.

# REQUIRED — OpenCode server auth password (no default; compose errors if unset).
OPENCODE_SERVER_PASSWORD=change-me

# OpenCode image tag. Default is the pin recorded in VERSIONS.lock.
OPENCODE_IMAGE_TAG=0.5.9

# Host loopback port the OpenCode server is published on (127.0.0.1 only).
OPENCODE_HOST_PORT=4096

# Egress proxy rate limiter. "Safe to pound" is a human judgement — leave OFF
# (conservative) unless a human has confirmed the target is safe to hammer.
SAFE_TO_POUND=false
RATE_RPS_PER_TARGET=1

# Path to the engagement ScopeConfig JSON (matches src/shared/scope.ts shape).
SCOPE_CONFIG_FILE=./infra/scope.example.json

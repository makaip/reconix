{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "pentest-orchestrator",
  "model": "gemini/gemini-flash-lite-latest",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 24000
    },
    "buffer": 8000
  },
  "providers": {
    "vllm-orchestrator": {
      "package": "@ai-sdk/openai-compatible",
      "name": "vLLM (orchestrator, local)",
      "settings": {
        "baseURL": "{env:ORCHESTRATOR_BASE_URL}",
        "apiKey": "{env:ORCHESTRATOR_API_KEY}"
      },
      "models": {
        "orchestrator-model": {
          "name": "Qwen3 orchestrator (remote deployment)",
          "body": {
            "temperature": 0.6,
            "top_p": 0.95,
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    },
    "gemini": {
      "package": "@ai-sdk/openai-compatible",
      "name": "Google Gemini (direct)",
      "settings": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "apiKey": "{env:GOOGLE_GENERATIVE_AI_API_KEY}"
      },
      "models": {
        "gemini-flash-lite-latest": {
          "name": "Gemini Flash Lite"
        }
      }
    },
    "openrouter": {
      "package": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "settings": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "dolphin3-mistral-24b": {
          "name": "Dolphin3 Mistral 24B (uncensored, high context)",
          "body": {
            "temperature": 0.7,
            "top_p": 0.95
          },
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "reconix_replay_request",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "reconix_replay_batch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "reconix_set_intercept_rule",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "reconix_submit_form",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "reconix_upload_files",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "reconix_probe_reflection",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "reconix_vary_parameter",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "reconix_run_tool",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "reconix_crawl_start",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "reconix_repeater_send",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "reconix_nuclei_scan",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "bash",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "pentest-orchestrator": {
      "mode": "primary",
      "description": "Lead Penetration Testing Orchestrator for an AI-driven security browser built on Electron and OpenCode. Coordinates autonomous security assessments: reconnaissance/mapping, hypothesis generation, delegation to @dom-analyzer and @evaluator, and reporting.",
      "model": "openrouter/dolphin3-mistral-24b"
    },
    "evaluator": {
      "mode": "subagent",
      "description": "Evidence Analysis and False-Positive Filtering subagent. Reviews execution logs, console output, DOM changes, and network responses from @pentest-orchestrator; validates hypotheses with strict evidence-based reasoning; responds only with the structured JSON evaluation format (vulnerable, confidence, reason). Does not execute actions, modify code, or run terminal commands.",
      "model": "opencode/grok-code",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "bash",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "dom-analyzer": {
      "mode": "subagent",
      "description": "Fast DOM Analyzer subagent. Inspects raw HTML snapshots, DOM trees, or accessibility trees; extracts elements, forms, inputs, attributes, and event handlers for @pentest-orchestrator; acts as a cheap filter to condense DOM noise into concise findings. Does not execute actions, modify code, or run terminal commands.",
      "model": "opencode/grok-code",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "bash",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "reconix": {
        "type": "remote",
        "url": "http://127.0.0.1:4102/mcp",
        "codemode": false
      }
    }
  }
}

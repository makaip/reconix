{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "providers": {
    "vllm-orchestrator": {
      "package": "@ai-sdk/openai-compatible",
      "name": "vLLM (orchestrator, local)",
      "settings": {
        "baseURL": "{env:ORCHESTRATOR_BASE_URL}",
        "apiKey": "{env:ORCHESTRATOR_API_KEY}"
      },
      "models": {
        "orchestrator-model": {
          "name": "Qwen 2.5 14B AWQ (orchestrator)",
          "limit": { "context": 32768, "output": 4096 }
        }
      }
    },
    "vllm-evaluator": {
      "package": "@ai-sdk/openai-compatible",
      "name": "vLLM (evaluator, local)",
      "settings": {
        "baseURL": "{env:EVALUATOR_BASE_URL}",
        "apiKey": "{env:EVALUATOR_API_KEY}"
      },
      "models": {
        "evaluator-model": {
          "name": "Qwen 2.5 7B AWQ (evaluator)",
          "limit": { "context": 16384, "output": 2048 }
        }
      }
    },
    "vllm-dom": {
      "package": "@ai-sdk/openai-compatible",
      "name": "vLLM (dom-analyzer, local)",
      "settings": {
        "baseURL": "{env:DOM_BASE_URL}",
        "apiKey": "{env:DOM_API_KEY}"
      },
      "models": {
        "dom-model": {
          "name": "Qwen 2.5 3B (dom-analyzer)",
          "limit": { "context": 8192, "output": 1024 }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "bash",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "src/**",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "description": "Lead Penetration Testing Orchestrator for an AI-driven security browser built on Electron and Playwright. Coordinates autonomous security assessments: reconnaissance/mapping, hypothesis generation, execution via tool scripts, delegation to @evaluator, and reporting.",
      "model": "vllm-orchestrator/orchestrator-model"
    },
    "evaluator": {
      "mode": "subagent",
      "description": "Evidence Analysis and False-Positive Filtering subagent. Reviews execution logs, console output, DOM changes, and network responses from @orchestrator; validates hypotheses with strict evidence-based reasoning; responds only with the structured JSON evaluation format (vulnerable, confidence, reason). Does not execute actions, modify code, or run terminal commands.",
      "model": "vllm-evaluator/evaluator-model",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "bash",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "dom-analyzer": {
      "mode": "subagent",
      "description": "Fast DOM Analyzer subagent. Inspects raw HTML snapshots, DOM trees, or accessibility trees; extracts elements, forms, inputs, attributes, and event handlers for @orchestrator; acts as a cheap filter to condense DOM noise into concise findings. Does not execute actions, modify code, or run terminal commands.",
      "model": "vllm-dom/dom-model",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "bash",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}